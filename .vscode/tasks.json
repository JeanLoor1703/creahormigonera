{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Creacom: iniciar vista previa",
      "type": "shell",
      "command": "node",
      "args": ["tools/preview-server.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": false },
      "problemMatcher": {
        "owner": "creacom-preview",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^$",
          "endsPattern": "^Vista local:"
        }
      }
    }
  ]
}
